<launch>
  <!-- FAST-LIO + SC-PGO (src/FAST_LIO_SLAM_ROS2) on the simulated RoboSense Airy (lidar:=true in the world launch).
       Start it once the robot stands still: FAST-LIO takes gravity and camera_init from the first IMU samples.
       TF:  lio_map -> camera_init -> rslidar_lio -> lio_base   (FAST-LIO, legged_gazebo/config/fast_lio_airy.yaml)
                       camera_init -> aft_pgo                   (SC-PGO, loop-closed rslidar_lio)
       lio_map is the base frame when FAST-LIO started, lio_base the base pose FAST-LIO estimates.
       Both offsets are the rslidar_joint xyz in robot.xacro; the rotation is in imu_R/extrinsic_R. -->
  <arg name="use_sim_time" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="pgo" default="true" description="Run SC-PGO loop closure (needs sc_pgo_ros2 built)"/>
  <arg name="people" default="false" description="Detect and track people and keep them out of the SC-PGO and TARE scans (people_perception)"/>
  <arg name="detector" default="fake" description="With people:=true: fake (knows where the people of people_script are) or centerpoint (autoware_lidar_centerpoint finds them in the points; needs CUDA and TensorRT)"/>
  <arg name="people_script" default="$(find-pkg-share people_perception)/config/fake_people_warehouse_actors.yaml"
       description="With detector:=fake: its script (default: the two actors of the Gazebo warehouse)"/>
  <arg name="centerpoint_model" default="$(env HOME)/RaNAV/models/lidar_centerpoint/v4.1/short_range"
       description="With detector:=centerpoint: folder of the model"/>
  <arg name="opti_pessi_obstacles" default="true"
       description="With people:=true: the tracked people go to OptiPessiController on /opti_pessi/obstacles. false when another node publishes that topic (yolo26_rgbd_detect)"/>
  <arg name="save_directory" default="$(env HOME)/.ros/sc_pgo/" description="SC-PGO poses and keyframes; its Scans/ subfolder is wiped on start"/>

  <node pkg="fast_lio" exec="fastlio_mapping" name="laser_mapping" output="screen">
    <param from="$(find-pkg-share legged_gazebo)/config/fast_lio_airy.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="tf2_ros" exec="static_transform_publisher" name="lio_map_to_camera_init"
    args="--x 0.2835 --z 0.066 --frame-id lio_map --child-frame-id camera_init"/>
  <node pkg="tf2_ros" exec="static_transform_publisher" name="rslidar_lio_to_lio_base"
    args="--x -0.2835 --z -0.066 --frame-id rslidar_lio --child-frame-id lio_base"/>

  <node if="$(var pgo)" pkg="sc_pgo_ros2" exec="alaserPGO" name="alaserPGO" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="save_directory" value="$(var save_directory)"/>
    <param name="keyframe_meter_gap" value="1.0"/>
    <param name="keyframe_deg_gap" value="10.0"/>
    <param name="sc_dist_thres" value="0.3"/>
    <param name="sc_max_radius" value="20.0"/>   <!-- indoor; Airy range is 60 m -->
    <param name="mapviz_filter_size" value="0.1"/>
    <param name="save_directory" value="./src/FAST_LIO_SLAM_ROS2/save_data/"/>
    <remap from="/aft_mapped_to_init" to="/Odometry"/>
    <remap from="/velodyne_cloud_registered_local" to="/cloud_registered_body_static"/>
  </node>

  <!-- people_perception (docs/perception_pipeline.md). Its dynamic_points_filter republishes the FAST-LIO scans for
       what accumulates them: /cloud_registered_body -> /cloud_registered_body_static for SC-PGO above,
       /cloud_registered -> /registered_scan_static for TARE (tare_planner/config/aliengo.yaml). Without it neither
       gets scans. people:=false: unchanged. people:=true: without the tracked people (cloud adapter, detector and
       tracker run too; detector:=fake knows from people_script where the two actors of the Gazebo warehouse walk,
       detector:=centerpoint finds people in the points, see that launch), and the tracked people are the obstacles
       of OptiPessiController (/opti_pessi/obstacles) unless opti_pessi_obstacles:=false. -->
  <include file="$(find-pkg-share people_perception)/launch/people_perception_launch.xml">
    <arg name="people" value="$(var people)"/>
    <arg name="detector" value="$(var detector)"/>
    <arg name="people_script" value="$(var people_script)"/>
    <arg name="centerpoint_model" value="$(var centerpoint_model)"/>
    <arg name="opti_pessi_obstacles" value="$(var opti_pessi_obstacles)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <node if="$(var rviz)" pkg="rviz2" exec="rviz2" name="fast_lio_rviz"
    args="-d $(find-pkg-share fast_lio)/rviz/fastlio.rviz">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
